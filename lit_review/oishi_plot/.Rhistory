install.packages("tikzDevice")
library(ggplot2)
library(tikzDevice)
data <- data.frame(
stand_age = rep(c("12 Year", "35 Year", "200 Year"), each = 3),
component = rep(c("$E_i$", "$E_c$", "$E_{sub}$"), times = 3),
value = c(35, 280, 120,
195, 545, 120,
360, 400, 60)
)
data$stand_age <- factor(data$stand_age, levels = c("12-year", "35-year", "200-year"))
View(data)
data$component <- factor(data$component, levels = c("$E_{sub}$", "$E_c$", "$E_i$"))
p <- ggplot(data, aes(x = stand_age, y = value, fill = component)) +
geom_bar(stat = "identity", width = 0.5) +
scale_fill_manual(
values = c("$E_i$" = "#2C5F2E", "$E_c$" = "#97BC62", "$E_{sub}$" = "#D4E6B5")
) +
labs(
x = "Stand Age",
y = "Annual ET (mm)",
fill = "ET Component"
) +
theme_classic() +
theme(
legend.position = "right",
axis.text = element_text(size = 11),
axis.title = element_text(size = 12)
)
tikz("oishi_et_plot.tex", width = 5, height = 4)
print(p)
p
show(p)
show(p)
tikz("oishiplot.tex", width = 5, height = 4)
