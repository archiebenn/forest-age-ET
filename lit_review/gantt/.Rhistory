library(ganttrify)
library(ggplot2)
library(tidyverse)
library(tikzDevice)
# read in csv
my_project <- read_csv("gannt.csv") %>%
# add a latex \space wherever a real space occurs for tikz
mutate(across(where(is.character), ~gsub(" ", "\\\\space ", .x)))
p <- ganttrify(
project = my_project,
by_date = TRUE,
exact_date = TRUE,
project_start_date = "2026-04",
)
show(p)
ggsave("gantt1.png", plot = p, width = 6, height = 4, dpi = 300)
# save as tikz for latex
tikz("gantt.tex", width = 6, height = 4)
show(p)
dev.off()
