library(ganttrify)
library(ggplot2)
library(tidyverse)
my_project <- read_csv("gannt.csv")
ganttrify(
project = my_project,
by_date = TRUE,
exact_date = TRUE,
project_start_date = "2026-04",
font_family = "Roboto Condensed"
)
ggsave("gannt/gantt1.png", plot = p, width = 12, height = 8, dpi = 300)
